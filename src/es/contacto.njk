<!-- CONTACT FORM -->
<section class="contact-section">
  <div class="container">
    <div class="contact-form">
      <p class="contact-form-lead">Cuéntanos sobre tu lugar, tu proyecto o tu idea. Incluso una idea en bruto puede ser un buen punto de partida.</p>
      <form id="contact-form" action="https://formspree.io/f/xjgjddlw" method="POST">
        <input type="hidden" name="_subject" value="Nuevo mensaje desde la web de The Defender Family">
        <input type="text" name="_gotcha" style="display:none" aria-hidden="true">

        <div class="form-group">
          <label for="name">Nombre</label>
          <input type="text" id="name" name="name" required>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>

        <div class="form-group">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" required></textarea>
        </div>

        <div class="form-submit">
          <button type="submit" class="btn btn-dark">Enviar mensaje</button>
        </div>
      </form>

      <script>
      document.getElementById('contact-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        const form = e.target;
        const btn = form.querySelector('button[type="submit"]');
        btn.textContent = 'Enviando…';
        btn.disabled = true;
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' }
          });
          if (res.ok) {
            window.location.href = '/es/gracias/';
          } else {
            btn.textContent = 'Enviar mensaje';
            btn.disabled = false;
            btn.insertAdjacentHTML('afterend', '<p style="color:red;margin-top:0.75rem;">Algo salió mal. Inténtalo de nuevo.</p>');
          }
        } catch(err) {
          btn.textContent = 'Enviar mensaje';
          btn.disabled = false;
          btn.insertAdjacentHTML('afterend', '<p style="color:red;margin-top:0.75rem;">Algo salió mal. Inténtalo de nuevo.</p>');
        }
      });
      </script>

    </div>
  </div>
</section>
