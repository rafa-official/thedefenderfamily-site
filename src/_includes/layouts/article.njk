---
layout: layouts/base.njk
---

<article class="article">
  <!-- Hero -->
  {% if heroImage %}{% set heroImageWebP = heroImage | replace('.jpg', '.webp') | replace('.jpeg', '.webp') %}{% endif %}
  <header class="article-hero" {% if heroImage %}style="background-image: url('{{ heroImage }}'); background-image: image-set(url('{{ heroImageWebP }}') type('image/webp'), url('{{ heroImage }}') type('image/jpeg'));" role="img" aria-label="{{ heroImageAlt or title }}"{% endif %}>
    <div class="article-hero-overlay">
      <div class="container">
        {% if category %}<div class="article-meta"><span class="article-category">{{ category }}</span></div>{% endif %}
        <h1 class="article-title">{{ title }}</h1>
        {% if subtitle %}<p class="article-subtitle">{{ subtitle }}</p>{% endif %}
        {% if author %}
        <p class="article-byline">By {% if authorUrl %}<a href="{{ authorUrl }}" class="article-byline-link">{{ author }}</a>{% else %}{{ author }}{% endif %}</p>
        {% endif %}
        {% if date %}<time class="article-date">{{ date | readableDate }}</time>{% endif %}
      </div>
    </div>
  </header>

  <!-- Share bar (top) -->
  <div class="article-body">
    <div class="article-content">
      <div class="share-bar">
        <span class="share-label">Share this story</span>
        <div class="share-buttons">
          <button class="share-btn share-btn--copy" onclick="copyStoryLink(this)" aria-label="Copy link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy link</span>
          </button>
          <a class="share-btn share-btn--whatsapp" href="https://wa.me/?text={{ title | urlencode }}%20{{ site.url }}{{ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.555 4.116 1.528 5.845L0 24l6.335-1.521A11.933 11.933 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.006-1.368l-.36-.214-3.727.977.994-3.634-.235-.374A9.818 9.818 0 0 1 2.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/></svg>
            <span>WhatsApp</span>
          </a>
          <a class="share-btn share-btn--linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url }}{{ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a class="share-btn share-btn--facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ site.url }}{{ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span>Facebook</span>
          </a>
        </div>
      </div>

      {{ content | safe }}
    </div>
  </div>

  <!-- Related stories (T18) -->
  {% set related = collections.stories | filterByAnyTag(tags) | rejectByUrl(page.url) | head(3) %}
  {% if related and related.length %}
  <aside class="related-stories">
    <div class="container">
      <h2 class="related-stories-heading">More stories from the road</h2>
      <div class="related-stories-grid">
        {% for post in related %}
        <a class="related-story-card" href="{{ post.url }}">
          {% if post.data.heroImage %}
          {% image post.data.heroImage, (post.data.heroImageAlt or post.data.title), "lazy", "(max-width: 768px) 100vw, 33vw" %}
          {% endif %}
          {% if post.data.category %}<div class="related-story-tag">{{ post.data.category }}</div>{% endif %}
          <h3>{{ post.data.title }}</h3>
          {% if post.data.subtitle %}<p>{{ post.data.subtitle }}</p>{% endif %}
        </a>
        {% endfor %}
      </div>
    </div>
  </aside>
  {% endif %}

  <!-- Share bar (bottom) -->
  <div class="article-body">
    <div class="article-content">
      <div class="share-bar">
        <span class="share-label">Share this story</span>
        <div class="share-buttons">
          <button class="share-btn share-btn--copy" onclick="copyStoryLink(this)" aria-label="Copy link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy link</span>
          </button>
          <a class="share-btn share-btn--whatsapp" href="https://wa.me/?text={{ title | urlencode }}%20{{ site.url }}{{ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.555 4.116 1.528 5.845L0 24l6.335-1.521A11.933 11.933 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.006-1.368l-.36-.214-3.727.977.994-3.634-.235-.374A9.818 9.818 0 0 1 2.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/></svg>
            <span>WhatsApp</span>
          </a>
          <a class="share-btn share-btn--linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url }}{{ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a class="share-btn share-btn--facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ site.url }}{{ page.url | urlencode }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span>Facebook</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Back link -->
  <div class="article-footer">
    <div class="container">
      <a href="/stories/" class="btn btn-dark">&larr; All stories</a>
    </div>
  </div>

  <script>
    function copyStoryLink(btn) {
      navigator.clipboard.writeText(window.location.href).then(function() {
        var span = btn.querySelector('span');
        var original = span.textContent;
        span.textContent = 'Copied!';
        btn.classList.add('share-btn--copied');
        setTimeout(function() {
          span.textContent = original;
          btn.classList.remove('share-btn--copied');
        }, 2000);
      });
    }
  </script>
</article>
