<!-- PAGE HERO -->
<section class="page-hero">
  <div class="page-hero-bg" style="background-image: url('/images/uploads/land-rover-defender-in-albanian-alps_002.jpg'); background-image: image-set(url('/images/uploads/land-rover-defender-in-albanian-alps_002.webp') type('image/webp'), url('/images/uploads/land-rover-defender-in-albanian-alps_002.jpg') type('image/jpeg'));"></div>
  <div class="page-hero-content">
